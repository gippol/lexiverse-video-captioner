<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
	<ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>

  <!--
    NPU (AMD Ryzen AI) 用の whisper.cpp。amd/whisper.cpp を -DWHISPER_VITISAI=1 でビルドし、
    リポジトリ直下の whisperCpp\build\bin\Release に置いたものを出力先の npu\ にコピーする。
    置いていない環境ではコピーされず、アプリでは NPU が選べなくなるだけ。
    Whisper.net の whisper.dll / ggml*.dll と混ざらないよう npu\ サブフォルダに分ける。
  -->
  <PropertyGroup>
    <NpuWhisperDir>$(MSBuildThisFileDirectory)..\whisperCpp\build\bin\Release\</NpuWhisperDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NpuWhisperDir)whisper-cli.exe')">
    <None Include="$(NpuWhisperDir)whisper-cli.exe;$(NpuWhisperDir)whisper.dll;$(NpuWhisperDir)ggml.dll;$(NpuWhisperDir)ggml-base.dll;$(NpuWhisperDir)ggml-cpu.dll;$(NpuWhisperDir)flexmlrt.dll"
          Link="npu\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
